        "audit_benchmark_make_inventory_listing_proof_bundle",
        "audit_verify_inventory_listing_proof_bundle",
      ],
    },
    "wasm-gc": {
      "exports": [
        "audit_benchmark_make_anchor_envelope",
        "audit_verify_anchor_envelope",
        "audit_classify_anchor_head",
        "audit_open_checkpoint_closure",
        "audit_prepare_atomic_checkpoint_seal",
        "audit_acknowledge_checkpoint_outbox",
        "audit_select_peer_delivery_batch",
        "audit_record_peer_delivery_failure",
        "audit_record_peer_delivery_success",
        "audit_select_peer_checkpoint_response",
        "audit_experimental_sign_checkpoint_delivery_approval",
        "audit_benchmark_make_checkpoint_delivery_authentication",
        "audit_verify_checkpoint_delivery_authentication",
        "audit_classify_central_replay",
        "audit_marketplace_creation_persist_allowed",
        "audit_inventory_head_advance_allowed",
        "audit_benchmark_make_pve_replay_bundle",
        "audit_verify_pve_replay_bundle",
        "audit_benchmark_make_pvp_replay_bundle",
        "audit_verify_pvp_replay_bundle",
