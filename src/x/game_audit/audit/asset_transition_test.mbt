///|
test "asset transfer requires every authorization condition" {
  assert_true(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=true,
      version_matches=true,
      recipient_valid=true,
      changes_owner=true,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=false,
      owner_matches=true,
      version_matches=true,
      recipient_valid=true,
      changes_owner=true,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=false,
      version_matches=true,
      recipient_valid=true,
      changes_owner=true,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=true,
      version_matches=false,
      recipient_valid=true,
      changes_owner=true,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=true,
      version_matches=true,
      recipient_valid=false,
      changes_owner=true,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=true,
      version_matches=true,
      recipient_valid=true,
      changes_owner=false,
      source_authenticated=true,
    ),
  )
  assert_false(
    transfer_transition_allowed(
      asset_exists=true,
      owner_matches=true,
      version_matches=true,
      recipient_valid=true,
      changes_owner=true,
      source_authenticated=false,
    ),
  )
}
