///|
test "PvP commands fail closed outside the public epoch rules" {
  assert_true(
    pvp_command_allowed(
      actor_hp=10,
      equivocated=false,
      tick=3,
      ticks_per_epoch=8,
      receipt_tick=4,
      max_late_ticks=2,
      move_distance=2,
      max_move_distance=3,
      destination_in_arena=true,
    ),
  )
  assert_false(
    pvp_command_allowed(
      actor_hp=0,
      equivocated=false,
      tick=3,
      ticks_per_epoch=8,
      receipt_tick=4,
      max_late_ticks=2,
      move_distance=2,
      max_move_distance=3,
      destination_in_arena=true,
    ),
  )
  assert_false(
    pvp_command_allowed(
      actor_hp=10,
      equivocated=true,
      tick=3,
      ticks_per_epoch=8,
      receipt_tick=4,
      max_late_ticks=2,
      move_distance=2,
      max_move_distance=3,
      destination_in_arena=true,
    ),
  )
  assert_false(
    pvp_command_allowed(
      actor_hp=10,
      equivocated=false,
      tick=3,
      ticks_per_epoch=8,
      receipt_tick=6,
      max_late_ticks=2,
      move_distance=2,
      max_move_distance=3,
      destination_in_arena=true,
    ),
  )
}

///|
test "PvP score requires an enemy-caused alive-to-defeated transition" {
  assert_eq(
    pvp_elimination_score_delta(
      target_hp_before=4,
      target_hp_after=0,
      enemy_damage=true,
      score_per_elimination=1,
    ),
    1,
  )
  assert_eq(
    pvp_elimination_score_delta(
      target_hp_before=0,
      target_hp_after=0,
      enemy_damage=true,
      score_per_elimination=1,
    ),
    0,
  )
  assert_eq(
    pvp_elimination_score_delta(
      target_hp_before=4,
      target_hp_after=0,
      enemy_damage=false,
      score_per_elimination=1,
    ),
    0,
  )
  assert_eq(
    pvp_elimination_score_delta(
      target_hp_before=4,
      target_hp_after=1,
      enemy_damage=true,
      score_per_elimination=1,
    ),
    0,
  )
}
