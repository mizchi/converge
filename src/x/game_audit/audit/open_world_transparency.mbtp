///|
predicate open_world_audit_transparency_post(
  trusted_publication_boundary : Bool,
  audit_checkpoint_authenticated : Bool,
  seal_checkpoint_authenticated : Bool,
  transparency_manifest_matches : Bool,
  audit_membership_valid : Bool,
  seal_membership_valid : Bool,
) {
  trusted_publication_boundary &&
  audit_checkpoint_authenticated &&
  seal_checkpoint_authenticated &&
  transparency_manifest_matches &&
  audit_membership_valid &&
  seal_membership_valid
}

///|
pub lemma published_open_world_audit_requires_every_capability(
  trusted_publication_boundary : Bool,
  audit_checkpoint_authenticated : Bool,
  seal_checkpoint_authenticated : Bool,
  transparency_manifest_matches : Bool,
  audit_membership_valid : Bool,
  seal_membership_valid : Bool,
) where {
  proof_require: open_world_audit_transparency_post(
    trusted_publication_boundary,
    audit_checkpoint_authenticated,
    seal_checkpoint_authenticated,
    transparency_manifest_matches,
    audit_membership_valid,
    seal_membership_valid,
  ),
  proof_ensure: trusted_publication_boundary == true,
  proof_ensure: audit_checkpoint_authenticated == true,
  proof_ensure: seal_checkpoint_authenticated == true,
  proof_ensure: transparency_manifest_matches == true,
  proof_ensure: audit_membership_valid == true,
  proof_ensure: seal_membership_valid == true,
} {
}

///|
pub lemma foreign_transparency_boundary_never_publishes(
  audit_checkpoint_authenticated : Bool,
  seal_checkpoint_authenticated : Bool,
  transparency_manifest_matches : Bool,
  audit_membership_valid : Bool,
  seal_membership_valid : Bool,
) where {
  proof_ensure: open_world_audit_transparency_post(
    false,
    audit_checkpoint_authenticated,
    seal_checkpoint_authenticated,
    transparency_manifest_matches,
    audit_membership_valid,
    seal_membership_valid,
  ) == false,
} {
}

///|
pub lemma missing_audit_membership_never_publishes(
  seal_membership_valid : Bool,
) where {
  proof_ensure: open_world_audit_transparency_post(
    true, true, true, true, false, seal_membership_valid,
  ) == false,
} {
}

///|
pub lemma missing_seal_membership_never_publishes() where {
  proof_ensure: open_world_audit_transparency_post(
    true, true, true, true, true, false,
  ) == false,
} {
}
