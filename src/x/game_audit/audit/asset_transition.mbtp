}

///|
pub lemma same_owner_rejects_transfer(
  asset_exists : Bool,
  owner_matches : Bool,
  version_matches : Bool,
  recipient_valid : Bool,
  source_authenticated : Bool,
  authorization : Bool,
) where {
  proof_require: transfer_transition_allowed_post(
    asset_exists,
    owner_matches,
    version_matches,
    recipient_valid,
    false,
    source_authenticated,
    authorization,
  ),
  proof_ensure: authorization == false,
