}

///|
pub lemma missing_source_rejects_transfer(
  asset_exists : Bool,
  owner_matches : Bool,
  version_matches : Bool,
  recipient_valid : Bool,
  changes_owner : Bool,
  authorization : Bool,
) where {
  proof_require: transfer_transition_allowed_post(
    asset_exists,
    owner_matches,
    version_matches,
    recipient_valid,
    changes_owner,
    false,
    authorization,
  ),
  proof_ensure: authorization == false,
} {
}
