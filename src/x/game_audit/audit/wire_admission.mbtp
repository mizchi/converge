} {
}

///|
pub lemma oversized_open_world_wire_proof_is_rejected(
  items_within_budget : Bool,
) where {
  proof_ensure: open_world_wire_admission_post(
    true,
    true,
    true,
    true,
    true,
    false,
    items_within_budget,
