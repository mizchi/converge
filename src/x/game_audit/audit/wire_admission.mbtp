}

///|
pub lemma oversized_open_world_wire_item_page_is_rejected() where {
  proof_ensure: open_world_wire_admission_post(
    true,
    true,
    true,
    true,
    true,
    true,
    false,
    RejectOpenWorldWireItemBudget,
  ),
} {
}
