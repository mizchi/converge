///|
predicate runtime_atomic_seal_advance_allowed_post(
  boundary_matches : Bool,
  closure_epoch_matches : Bool,
  closure_available : Bool,
  exact_next : Bool,
  parent_matches : Bool,
  destinations_valid : Bool,
  capacity_available : Bool,
  created_order_available : Bool,
  result : Bool,
) {
  if boundary_matches {
    if closure_epoch_matches {
      if closure_available {
        if exact_next {
          if parent_matches {
            if destinations_valid {
              if capacity_available {
                result == created_order_available
              } else {
                result == false
              }
            } else {
              result == false
            }
          } else {
            result == false
          }
        } else {
          result == false
        }
      } else {
        result == false
      }
    } else {
      result == false
    }
  } else {
    result == false
  }
}

///|
pub lemma prepared_atomic_seal_requires_every_binding(
  boundary_matches : Bool,
  closure_epoch_matches : Bool,
  closure_available : Bool,
  exact_next : Bool,
  parent_matches : Bool,
  destinations_valid : Bool,
  capacity_available : Bool,
  created_order_available : Bool,
) where {
  proof_require: runtime_atomic_seal_advance_allowed_post(
    boundary_matches,
    closure_epoch_matches,
    closure_available,
    exact_next,
    parent_matches,
    destinations_valid,
    capacity_available,
    created_order_available,
    true,
  ),
  proof_ensure: boundary_matches == true,
  proof_ensure: closure_epoch_matches == true,
  proof_ensure: closure_available == true,
  proof_ensure: exact_next == true,
  proof_ensure: parent_matches == true,
  proof_ensure: destinations_valid == true,
  proof_ensure: capacity_available == true,
  proof_ensure: created_order_available == true,
} {
}

///|
pub lemma unavailable_capacity_never_prepares_atomic_seal(
  boundary_matches : Bool,
  closure_epoch_matches : Bool,
  closure_available : Bool,
  exact_next : Bool,
  parent_matches : Bool,
  destinations_valid : Bool,
  created_order_available : Bool,
) where {
  proof_ensure: runtime_atomic_seal_advance_allowed_post(
    boundary_matches,
    closure_epoch_matches,
    closure_available,
    exact_next,
    parent_matches,
    destinations_valid,
    false,
    created_order_available,
    false,
  ),
} {
}
