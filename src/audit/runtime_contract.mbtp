  proof_ensure: runtime_checkpoint_delivery_authentication_allowed_post(
    statement_valid,
    policy_valid,
    producer_identity_matches,
    false,
    roster_valid,
    quorum_satisfied,
    false,
  ),
} {
}

///|
pub lemma under_quorum_never_authenticates_checkpoint_delivery(
  statement_valid : Bool,
  policy_valid : Bool,
  producer_identity_matches : Bool,
  producer_signature_valid : Bool,
  roster_valid : Bool,
