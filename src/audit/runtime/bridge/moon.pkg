import {
  "mizchi/converge/audit" @checkpoint_audit,
  "mizchi/converge/audit/commitment",
  "mizchi/converge/audit/runtime" @audit_runtime,
  "moonbitlang/core/json",
}

supported_targets = "+js+wasm+wasm-gc"

options(
  link: {
    "js": {
      "exports": [
        "audit_classify_checkpoint_head",
        "audit_open_checkpoint_closure",
        "audit_prepare_atomic_checkpoint_seal",
        "audit_acknowledge_checkpoint_outbox",
        "audit_select_peer_delivery_batch",
        "audit_record_peer_delivery_failure",
        "audit_record_peer_delivery_success",
        "audit_select_peer_checkpoint_response",
      ],
    },
    "wasm-gc": {
      "exports": [
        "audit_classify_checkpoint_head",
        "audit_open_checkpoint_closure",
        "audit_prepare_atomic_checkpoint_seal",
        "audit_acknowledge_checkpoint_outbox",
        "audit_select_peer_delivery_batch",
        "audit_record_peer_delivery_failure",
        "audit_record_peer_delivery_success",
        "audit_select_peer_checkpoint_response",
      ],
      "use-js-builtin-string": true,
    },
  },
)
